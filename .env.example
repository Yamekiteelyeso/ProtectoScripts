JWT_SECRET=pone-aca-un-texto-largo-y-random
# Opcional en Railway: si no la ponés usa el dominio público que Railway genera solo
# BASE_URL=https://tu-app.up.railway.app

# Opcional: la base se crea sola. Solo cambiala si montaste un Volume (ej. /data/lexy.db)
# DB_PATH=/data/lexy.db

# Opcional: nombre.tudominio.com (necesita dominio propio con wildcard *.tudominio.com)
# BASE_DOMAIN=tudominio.com

# Opcional: 'strict' detecta funciones hookeadas con islclosure (puede dar falsos positivos en algunos executors)
# ANTI_HOOK=strict

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
